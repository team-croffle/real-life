{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/../tsconfig.json" }]
  },
  "moduleNameMapper": {
    "^@nest-vue/shared$": "<rootDir>/../../shared/src/index.ts",
    "^@nest-vue/shared/(.*)$": "<rootDir>/../../shared/src/$1",
    "^@/(.*)$": "<rootDir>/../src/$1"
  }
}
