        "quests_schedule_xor": {
          "name": "quests_schedule_xor",
          "value": "(\n        (\n          \"quests\".\"schedule\" = 'routine'\n          AND \"quests\".\"ends_on\" IS NULL\n          AND \"quests\".\"weekdays\" IS NOT NULL\n          AND cardinality(\"quests\".\"weekdays\") >= 1\n          AND \"quests\".\"biweekly\" IS NOT NULL\n        )\n        OR\n        (\n          \"quests\".\"schedule\" = 'deadline'\n          AND \"quests\".\"ends_on\" IS NOT NULL\n          AND \"quests\".\"weekdays\" IS NULL\n          AND \"quests\".\"biweekly\" IS NULL\n        )\n      )"
        },
        "quests_pace": {
          "name": "quests_pace",
          "value": "(\n        (\"quests\".\"schedule\" = 'routine' AND \"quests\".\"pace\" IS NULL)\n        OR\n        (\"quests\".\"schedule\" = 'deadline' AND \"quests\".\"pace\" IS NOT NULL)\n      )"
        },
        "quests_rest_period": {
          "name": "quests_rest_period",
          "value": "(\n        (\n          \"quests\".\"schedule\" = 'deadline'\n          AND \"quests\".\"rest_from\" IS NULL\n          AND \"quests\".\"rest_until\" IS NULL\n        )\n        OR\n        (\n          \"quests\".\"schedule\" = 'routine'\n          AND (\n            (\"quests\".\"rest_from\" IS NULL AND \"quests\".\"rest_until\" IS NULL)\n            OR\n            (\n              \"quests\".\"rest_from\" IS NOT NULL\n              AND (\"quests\".\"rest_until\" IS NULL OR \"quests\".\"rest_until\" >= \"quests\".\"rest_from\")\n            )\n          )\n        )\n      )"
        }
      },
      "isRLSEnabled": false
